/* pages/caption_secondFloor/caption_secondFloor.wxss */

.page-container {
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    overflow: hidden;
    position:fixed;
  }
  
  .content-wrapper {
    padding: 30rpx;
    transition: transform 0.1s ease;
    transform-origin:50% 50%;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    will-change: transform;
  }

  .Grid_layout{
      display: grid;
      grid-template-columns: repeat(20,1fr);
      grid-template-rows: repeat(40,1fr);
      width: 100%;
      height: 100%;
  }
  
  .fold-item {
    border: 1rpx solid #eee;
    border-radius: 8rpx;
    background-color:black;
  }

  .container{
      padding:0;
  }
  
  .reset-btn {
    position: fixed;
    bottom: 30rpx;
    right: 30rpx;
    background-color: #07c160;
    color: #fff;
    padding: 16rpx 32rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
    z-index: 999;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  }
  
  .reset-btn:active {
    opacity: 0.8;
  }

  .class1{
    grid-row-start: 25;
    grid-row-end: 27;
    grid-column-start: 1;
    grid-column-end: 5;
  }

  .class2{
      grid-row-start: 22;
      grid-row-end: 24;
      grid-column-start: 1;
      grid-column-end: 5;
  }

  .class3{
    grid-row-start: 19;
    grid-row-end: 21;
    grid-column-start: 1;
    grid-column-end: 5;
  }

  .class4{
    grid-row-start: 16;
    grid-row-end: 18;
    grid-column-start: 1;
    grid-column-end: 5;
  }

  .class5{
    grid-row-start: 13;
    grid-row-end: 15;
    grid-column-start: 1;
    grid-column-end: 5;
  }
  
  .class6{
    grid-row-start: 10;
    grid-row-end: 12;
    grid-column-start: 1;
    grid-column-end: 5;
  }

  .class7{
    grid-row-start: 7;
    grid-row-end: 9;
    grid-column-start: 1;
    grid-column-end: 5;
  }

  .class8{
    grid-row-start: 5;
    grid-row-end: 6;
    grid-column-start: 1;
    grid-column-end: 5;
  }

  .class9{
    grid-row-start: 1;
    grid-row-end: 4;
    grid-column-start: 1;
    grid-column-end: 8;
  }

  .class10{
    grid-row-start: 1;
    grid-row-end: 3;
    grid-column-start: 15;
    grid-column-end: 20;
  }

  .class11{
    grid-row-start: 3;
    grid-row-end: 5;
    grid-column-start: 15;
    grid-column-end: 20;
  }

  .class12{
    grid-row-start: 5;
    grid-row-end: 6;
    grid-column-start: 15;
    grid-column-end: 20;
  }

  /* 遮罩层样式 */
  .modal-mask {
    position:absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
  }
  
  /* 弹窗内容样式 */
  .modal-content {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    padding-left:5%;
    padding-right:5%;
    max-width: 600rpx;
    max-height: 70vh;
    background-color: #f5f5f5;
    border-radius: 16rpx;
    overflow: hidden;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  }
  
  /* 弹窗头部 */
  .modal-header {
    padding: 30rpx;
    border-bottom: 2rpx solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .modal-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .modal-close {
    font-size: 36rpx;
    color: #999;
    padding: 10rpx;
  }
  
  /* 弹窗主体 - 可滚动区域 */
  .modal-body {
    height: 400px;
    background-color: #f5f5f5;
  }

  .textTitle{
      color:#fff;
      font-size: 18px;
  }

  .textContent{
      font-size: 14px;
  }

  .textNote{
      font-size: 10px;
  }